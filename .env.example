# =============================================================================
# Rental POS Environment Variables Template
# =============================================================================

# Supabase (Public & Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub API Integration (Server-side ONLY)
# CRITICAL: ห้ามใส่ prefix NEXT_PUBLIC_ เพื่อป้องกัน Token รั่วไหลไปฝั่ง Browser
# ใส่ GitHub Personal Access Token (classic หรือ fine-grained) ที่มีสิทธิ์อ่าน repo ใน .env.local
GITHUB_TOKEN=
